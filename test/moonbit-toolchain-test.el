;;; moonbit-toolchain-test.el --- Real build integration -*- lexical-binding: t; -*-

(require 'ert)
(require 'compile)
(require 'warnings)
(require 'moonbit-mode)

(when-let* ((directory (getenv "MOONBIT_TEST_GRAMMAR_DIR")))
  (add-to-list 'treesit-extra-load-path directory))

(ert-deftest moonbit-toolchain-test-build-next-error ()
  "Build from a subpackage through project.el and visit the actual compiler error."
  (should (executable-find "moon"))
  (let* ((root (file-name-as-directory (file-truename (make-temp-file "moonbit build test " t))))
         (default-directory root)
         (process-environment (copy-sequence process-environment))
         (compilation-read-command nil)
         (compilation-ask-about-save nil)
         (compilation-save-buffers-predicate #'ignore)
         (compilation-buffer-name-function (lambda (_) " *moonbit build test*"))
         (warning-suppress-log-types '((treesit)))
         (warning-suppress-types '((treesit)))
         compilation process)
    (unwind-protect
        (save-window-excursion
          (setenv "MOON_WORK" nil)
          (setenv "MOON_NO_WORKSPACE" nil)
          (make-directory (expand-file-name "src/" root))
          (dolist (file '(("moon.mod" . "name = \"test/build_integration\"\n")
                          ("src/moon.pkg" . "")
                          ("src/bad.mbt" . "pub fn broken() -> Int32 {\n  \"wrong\"\n}\n")))
            (with-temp-file (expand-file-name (car file) root) (insert (cdr file))))
          (with-current-buffer (find-file-noselect (expand-file-name "src/bad.mbt" root))
            (should (equal default-directory (expand-file-name "src/" root)))
            (should (equal compile-command "moon build"))
            (setq compilation (project-compile)))
          (setq process (get-buffer-process compilation))
          (let ((deadline (+ (float-time) 20)))
            (while (and (process-live-p process) (< (float-time) deadline))
              (accept-process-output process 0.1)))
          (should-not (process-live-p process))
          (should-not (zerop (process-exit-status process)))
          (with-current-buffer compilation
            (should (string-match-p "Expr Type Mismatch" (buffer-string))))
          (switch-to-buffer compilation)
          (should (equal default-directory root))
          (goto-char (point-min))
          (next-error 1 t)
          (with-current-buffer (window-buffer (selected-window))
            (should (equal (file-truename buffer-file-name) (expand-file-name "src/bad.mbt" root)))
            (should (= (line-number-at-pos) 2))
            (should (= (current-column) 2)))
          (message "[live build] project-compile used the module root; next-error visited src/bad.mbt:2:3"))
      (when (process-live-p process) (delete-process process))
      (when (buffer-live-p compilation) (kill-buffer compilation))
      (dolist (buffer (buffer-list))
        (when (and (buffer-file-name buffer) (file-in-directory-p (buffer-file-name buffer) root))
          (with-current-buffer buffer (set-buffer-modified-p nil))
          (kill-buffer buffer)))
      (delete-directory root t))))

;;; moonbit-toolchain-test.el ends here
