(ert-deftest moonbit-test-file-associations ()
  (dolist (name '("main.mbt" "pkg.generated.mbti" "moon.pkg" "moon.mod" "moon.work"))
    (let ((buffer-file-name (expand-file-name name "/tmp/moonbit-example/")))
      (should (eq (assoc-default buffer-file-name auto-mode-alist #'string-match)
                  'moonbit-mode))))
  (dolist (name '("README.mbt.md" "test.mbtp" "tool.mbtx" "moon.mod.json" "othermoon.pkg"))
    (should-not (eq (assoc-default name auto-mode-alist #'string-match) 'moonbit-mode))))

(ert-deftest moonbit-test-no-parser-comments ()
  (with-temp-buffer
    (let ((treesit-load-name-override-list
           '((moonbit "missing-moonbit-test-grammar" "tree_sitter_moonbit")))
          (warning-suppress-types '((treesit)))
          (warning-suppress-log-types '((treesit))))
      (moonbit-mode))
    (should-not (treesit-parser-list))
    (insert "let value = 1")
    (goto-char (point-min))
    (comment-dwim nil)
    (should (string-match-p "//" (buffer-string)))
    (erase-buffer)
    (insert "// comment\nlet value = 1\n/* block */\n")
    (goto-char (point-min))
    (search-forward "comment")
    (should (nth 4 (syntax-ppss)))
    (forward-line 1)
    (back-to-indentation)
    (should-not (nth 4 (syntax-ppss)))
    (search-forward "block")
    (should (nth 4 (syntax-ppss)))))

(ert-deftest moonbit-test-eglot-opt-in ()
  (require 'eglot)
  (should (equal (cdr (assq 'moonbit-mode eglot-server-programs)) '("moon" "lsp")))
  (should-not (memq #'eglot-ensure moonbit-mode-hook)))

(defmacro moonbit-test--with-project (files &rest body)
  (declare (indent 1))
  `(let* ((root (file-name-as-directory (file-truename (make-temp-file "moonbit project " t))))
          (default-directory root)
          (process-environment (copy-sequence process-environment))
          (project-find-functions '(moonbit-project-find project-try-vc)))
     (unwind-protect
         (progn
           (setenv "MOON_WORK" nil)
           (setenv "MOON_NO_WORKSPACE" nil)
           (dolist (file ,files)
             (let ((path (expand-file-name (car file) root)))
               (make-directory (file-name-directory path) t)
               (with-temp-file path (insert (cdr file)))))
           ,@body)
       (dolist (buffer (buffer-list))
         (when (and (buffer-file-name buffer) (file-in-directory-p (buffer-file-name buffer) root))
           (with-current-buffer buffer (set-buffer-modified-p nil))
           (kill-buffer buffer)))
       (delete-directory root t))))

(ert-deftest moonbit-test-project-module-roots ()
  (dolist (manifest '("moon.mod" "moon.mod.json"))
    (moonbit-test--with-project `((,manifest . "") ("src/sub/moon.pkg" . ""))
      (should (equal (project-root (project-current nil (expand-file-name "src/sub/" root))) root))
      (should-not (moonbit-project-find (file-name-directory (directory-file-name root)))))))

(ert-deftest moonbit-test-project-workspace-membership ()
  (moonbit-test--with-project
      '(("moon.work" . "// members = [\"./unrelated\"]\nmembers = [\n  \"./member\", // comment\n]\n")
        ("member/moon.mod" . "") ("member/src/moon.pkg" . "")
        ("other/moon.mod" . "") ("other/src/moon.pkg" . ""))
    (should (equal (project-root (project-current nil (expand-file-name "member/src/" root))) root))
    (should (equal (project-root (project-current nil (expand-file-name "other/src/" root)))
                   (expand-file-name "other/" root)))
    (setenv "MOON_WORK" "off")
    (should (equal (project-root (project-current nil (expand-file-name "member/src/" root)))
                   (expand-file-name "member/" root)))
    (setenv "MOON_WORK" (expand-file-name "moon.work" root))
    (should (equal (project-root (project-current nil (expand-file-name "other/src/" root))) root))
    (should-not (moonbit-project-find (file-name-directory (directory-file-name root))))))

(ert-deftest moonbit-test-project-files-respect-ignores ()
  (moonbit-test--with-project
      '(("moon.mod" . "") ("src/moon.pkg" . "") ("src/main.mbt" . "")
        ("_build/debug/generated.mbt" . "") (".mooncakes/dependency.mbt" . ""))
    (let ((files (project-files (project-current nil root))))
      (should (member (expand-file-name "src/main.mbt" root) files))
      (should-not (member (expand-file-name "_build/debug/generated.mbt" root) files))
      (should-not (member (expand-file-name ".mooncakes/dependency.mbt" root) files)))))

(ert-deftest moonbit-test-project-files-respect-git-ignores ()
  (moonbit-test--with-project
      '(("moon.mod" . "") ("main.mbt" . "") ("ignored.mbt" . "")
        (".gitignore" . "ignored.mbt\n"))
    (should (zerop (call-process "git" nil nil nil "init" "-q" root)))
    (let ((files (project-files (project-current nil root))))
      (should (member (expand-file-name "main.mbt" root) files))
      (should-not (member (expand-file-name "ignored.mbt" root) files)))))

(ert-deftest moonbit-test-compilation-defaults ()
  (with-temp-buffer
    (let ((moonbit-compile-command "moon check"))
      (moonbit-mode)
      (should (equal compile-command "moon check")))
    (should (eq (lookup-key moonbit-mode-map (kbd "C-c C-c")) #'project-compile))))

(ert-deftest moonbit-test-compilation-diagnostic-locations ()
  (dolist (rendered '(t nil))
    (moonbit-test--with-project '(("moon.mod" . "") ("src/bad.mbt" . "fn bad {\n  wrong\n}\n"))
      (save-window-excursion
        (let ((buffer (generate-new-buffer " *moonbit compilation*"))
              (file (expand-file-name "src/bad.mbt" root)))
          (unwind-protect
              (progn
                (switch-to-buffer buffer)
                (compilation-mode)
                (let ((inhibit-read-only t))
                  (insert "Compilation started\n\n")
                  (insert (if rendered
                              (format "Error: [4014]\n   ╭─[ %s:2:3 ]\n" file)
                            (format "%s:2:3-2:8 [E4014] Expr Type Mismatch\n" file))))
                (goto-char (point-min))
                (next-error 1 t)
                (with-current-buffer (window-buffer (selected-window))
                  (should (equal (file-truename buffer-file-name) file))
                  (should (= (line-number-at-pos) 2))
                  (should (= (current-column) 2))))
            (kill-buffer buffer)))))))

(ert-deftest moonbit-test-compilation-warning-severity ()
  (dolist (message '("Warning: [0001]\n   ╭─[ /tmp/unused.mbt:1:4 ]\n"
                     "/tmp/unused.mbt:1:4-1:8 [W0001] Unused function\n"))
    (with-temp-buffer
      (compilation-mode)
      (let ((inhibit-read-only t)) (insert message))
      (compilation--ensure-parse (point-max))
      (should (= compilation-num-warnings-found 1))
      (should (= compilation-num-errors-found 0)))))

