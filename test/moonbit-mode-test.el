;;; moonbit-mode-test.el --- MoonBit editing regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'imenu)
(require 'warnings)
(require 'compile)
(require 'moonbit-mode)

(when-let* ((directory (getenv "MOONBIT_TEST_GRAMMAR_DIR")))
  (add-to-list 'treesit-extra-load-path directory))

(defconst moonbit-test--fixtures
  (expand-file-name "fixtures" (file-name-directory (or load-file-name buffer-file-name))))

(defmacro moonbit-test--with-source (source &rest body)
  (declare (indent 1))
  `(with-temp-buffer
     ;; Parser tests must fail, rather than silently skip, without a grammar.
     (should (treesit-language-available-p 'moonbit))
     (insert ,source)
     (moonbit-mode)
     (should (treesit-parser-list))
     (should-not (treesit-node-check (treesit-buffer-root-node 'moonbit) 'has-error))
     ,@body))

(defun moonbit-test--fixture (name)
  (with-temp-buffer
    (insert-file-contents (expand-file-name name moonbit-test--fixtures))
    (buffer-string)))

(defun moonbit-test--face (text &optional occurrence)
  (goto-char (point-min))
  (search-forward text nil nil (or occurrence 1))
  (get-text-property (- (point) (length text)) 'face))

(ert-deftest moonbit-test-grammar-and-fixtures ()
  (dolist (name '("editing.mbt" "indent.mbt" "api.mbti" "moon.pkg" "moon.mod"))
    (moonbit-test--with-source (moonbit-test--fixture name)
      (font-lock-ensure)
      (should treesit-font-lock-settings))))

(ert-deftest moonbit-test-modern-highlighting ()
  (moonbit-test--with-source (moonbit-test--fixture "editing.mbt")
    (font-lock-ensure)
    (dolist (keyword '("async" "guard" "for i" "in 0..<10" "suberror" "extenum" "impl" "with"))
      (should (eq (moonbit-test--face keyword) 'font-lock-keyword-face)))
    (should (eq (moonbit-test--face "Int32") 'font-lock-type-face))
    (should (eq (moonbit-test--face "UInt32") 'font-lock-type-face))
    (should (eq (moonbit-test--face "#derive") 'font-lock-preprocessor-face))
    (should (eq (moonbit-test--face "convert") 'font-lock-function-name-face))
    (should (eq (moonbit-test--face "1.5") 'font-lock-number-face))
    (dolist (literal '("b'a'" "b\"hello\"" "re\"[a-z]+\""))
      (should (eq (moonbit-test--face literal) 'font-lock-string-face)))
    (should (eq (moonbit-test--face "/* A block comment.") 'font-lock-comment-face))
    (should (eq (moonbit-test--face "LIMIT") 'font-lock-constant-face))
    (should (eq (moonbit-test--face "consume") 'font-lock-function-call-face))))

(ert-deftest moonbit-test-string-and-interpolation-faces ()
  (moonbit-test--with-source (moonbit-test--fixture "editing.mbt")
    (font-lock-ensure)
    (should (eq (moonbit-test--face "#|") 'font-lock-comment-face))
    (should (eq (moonbit-test--face "literal ") 'font-lock-string-face))
    (should (eq (moonbit-test--face "\\{text}") 'font-lock-string-face))
    (should (eq (moonbit-test--face "$|") 'font-lock-comment-face))
    (should (eq (moonbit-test--face "point: " 2) 'font-lock-string-face))
    (should (eq (moonbit-test--face "\\{self.x}") 'font-lock-misc-punctuation-face))
    (should (eq (moonbit-test--face "self.x}") 'font-lock-variable-name-face))
    (should (eq (moonbit-test--face "self.x + 1}") 'font-lock-variable-name-face))
    (should (eq (moonbit-test--face "+ 1}") 'font-lock-operator-face))
    (goto-char (point-min))
    (search-forward "\\{self.x}")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-misc-punctuation-face))))

(ert-deftest moonbit-test-pipe-call-faces ()
  (moonbit-test--with-source "fn main { let x = 1 |> transform; let y = transform <| x }"
    (font-lock-ensure)
    (should (eq (moonbit-test--face "transform" 1) 'font-lock-function-call-face))
    (should (eq (moonbit-test--face "transform" 2) 'font-lock-function-call-face))
    (should (eq (moonbit-test--face "|>") 'font-lock-operator-face))
    (should (eq (moonbit-test--face "<|") 'font-lock-operator-face))))

(ert-deftest moonbit-test-literal-syntax-and-interpolation ()
  (moonbit-test--with-source
      (concat "fn main {\n"
              "  let char = '\"'\n"
              "  let byte = b'\\''\n"
              "  let raw =\n"
              "    #|literal \" // \\ { [\n"
              "  let text =\n"
              "    $|literal // \\{value + 1} rest\n"
              "  let ordinary = \"text \\{value} rest\"\n"
              "  let after = 1\n}\n")
    (dolist (text '("literal \"" "literal //" "rest" "\"text "))
      (goto-char (point-min))
      (search-forward text)
      (should (nth 3 (syntax-ppss)))
      (should-not (nth 4 (syntax-ppss))))
    (dolist (text '("value +" "value}" "after"))
      (goto-char (point-min))
      (search-forward text)
      (when (equal text "value}") (backward-char))
      (should-not (nth 3 (syntax-ppss)))
      (should-not (nth 4 (syntax-ppss))))
    (goto-char (point-min))
    (search-forward "after")
    (should (= (car (syntax-ppss)) 1))))

(ert-deftest moonbit-test-literal-syntax-updates-after-edit ()
  (moonbit-test--with-source "fn main {\n  let raw =\n    #|hello // text\n  let after = 1\n}\n"
    (goto-char (point-min))
    (search-forward "hello")
    (should (nth 3 (syntax-ppss)))
    (insert " \" \\")
    (search-forward "after")
    (should-not (nth 3 (syntax-ppss)))
    (should-not (nth 4 (syntax-ppss)))
    (goto-char (point-min))
    (search-forward "#|")
    (delete-region (- (point) 2) (point))
    (insert "//")
    (search-forward "hello")
    (should (nth 4 (syntax-ppss)))
    (goto-char (point-min))
    (search-forward "//")
    (delete-region (- (point) 2) (point))
    (insert "#|")
    (search-forward "hello")
    (should (nth 3 (syntax-ppss)))
    (should-not (nth 4 (syntax-ppss)))))

(ert-deftest moonbit-test-interpolation-syntax-updates-after-edit ()
  (moonbit-test--with-source "fn main {\n  let text = \"hello \\{value} rest\"\n  let after = 1\n}\n"
    (goto-char (point-min))
    (search-forward "value")
    (should-not (nth 3 (syntax-ppss)))
    (search-backward "\\{")
    (delete-char 1)
    (search-forward "value")
    (should (nth 3 (syntax-ppss)))
    (search-forward "after")
    (should-not (nth 3 (syntax-ppss)))
    (search-backward "{value")
    (insert "\\")
    (search-forward "value")
    (should-not (nth 3 (syntax-ppss)))
    (search-forward "after")
    (should-not (nth 3 (syntax-ppss)))))

(ert-deftest moonbit-test-multiline-string-trailing-whitespace ()
  (dolist (literal '("$|x \\{1}" "#|"))
    (moonbit-test--with-source
        (concat "fn main {\n  let text =\n    " literal "\n  let after = 1 // note\n}\n")
      (dotimes (step 3)
        (goto-char (point-min))
        (search-forward literal)
        (cond ((= step 1) (insert " \t "))
              ((= step 2) (delete-region (point) (+ (point) 3))))
        (search-forward "after")
        (should-not (nth 3 (syntax-ppss)))
        (search-forward "note")
        (should (nth 4 (syntax-ppss)))))))

(ert-deftest moonbit-test-configuration-faces ()
  (moonbit-test--with-source (moonbit-test--fixture "moon.pkg")
    (font-lock-ensure)
    (should (eq (moonbit-test--face "import") 'font-lock-keyword-face))
    (should (eq (moonbit-test--face "options") 'font-lock-function-call-face))
    (should (eq (moonbit-test--face "supported_targets") 'font-lock-variable-name-face))
    (should (eq (moonbit-test--face "\"native\"") 'font-lock-string-face))))

(ert-deftest moonbit-test-indent-fixtures ()
  (dolist (name '("editing.mbt" "indent.mbt" "api.mbti" "moon.pkg" "moon.mod"))
    (let ((expected (moonbit-test--fixture name)))
      (moonbit-test--with-source expected
        (goto-char (point-min))
        (while (re-search-forward "^[ \t]+" nil t) (replace-match ""))
        (indent-region (point-min) (point-max))
        (should (equal (buffer-string) expected))
        (indent-region (point-min) (point-max))
        (should (equal (buffer-string) expected))))))

(ert-deftest moonbit-test-custom-indent-offset ()
  (let ((moonbit-indent-offset 4))
    (moonbit-test--with-source "fn main {\nprintln(1)\n}\n"
      (indent-region (point-min) (point-max))
      (should (equal (buffer-string) "fn main {\n    println(1)\n}\n")))))

(ert-deftest moonbit-test-indent-new-lines-in-unfinished-code ()
  (dolist (case '(("fn main {\n" . 2)
                  ("fn main {\n  consume(\n" . 4)
                  ("fn main {\n  match value {\n    Some(n) =>\n" . 6)))
    (with-temp-buffer
      (insert (car case))
      (moonbit-mode)
      (goto-char (point-max))
      (indent-for-tab-command)
      (should (= (current-indentation) (cdr case)))
      (indent-for-tab-command)
      (should (= (current-indentation) (cdr case))))))

(ert-deftest moonbit-test-do-not-indent-string-data ()
  (dolist (continuation '("   second\"" "    \"" "    \\{1}\""
                          "    \\nsecond\"" "\\{1}\"" "\""))
    (let ((source (concat "fn main {\n  let text = \"first\n" continuation "\n}\n")))
      (moonbit-test--with-source source
        (indent-region (point-min) (point-max))
        (should (equal (buffer-string) source))))))

(ert-deftest moonbit-test-definition-names ()
  (moonbit-test--with-source (moonbit-test--fixture "editing.mbt")
    (let* ((nodes (treesit-node-children (treesit-buffer-root-node 'moonbit) t))
           (names (mapcar #'moonbit--treesit-defun-name nodes)))
      (dolist (name '("Point" "UserId" "ParseError" "Event" "@events.Event" "Printable" "Point::convert"
                      "pipes" "Printable for Point::print" "\"point\"" "test" "LIMIT"))
        (should (member name names))))))

(ert-deftest moonbit-test-imenu ()
  (moonbit-test--with-source (moonbit-test--fixture "editing.mbt")
    (let ((index (funcall imenu-create-index-function)))
      (should (assoc "Point::convert" (cdr (assoc "Function" index))))
      (should (assoc "UserId" (cdr (assoc "Struct" index))))
      (should (assoc "@events.Event" (cdr (assoc "Enum" index))))
      (should (assoc "Printable" (cdr (assoc "Trait" index))))
      (should (assoc "Printable for Point::print" (cdr (assoc "Impl" index))))
      (should (assoc "test" (cdr (assoc "Test" index)))))))

(ert-deftest moonbit-test-defun-navigation ()
  (moonbit-test--with-source (moonbit-test--fixture "editing.mbt")
    (goto-char (point-min))
    (search-forward "let items")
    (beginning-of-defun)
    (should (looking-at-p "#deprecated"))
    (end-of-defun)
    (should (looking-back "}\n" (- (point) 2)))
